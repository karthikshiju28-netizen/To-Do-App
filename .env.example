# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase (dashboard -> Project Settings -> API Keys)
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" key or the "publishable" key (safe to expose; protected by RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Anthropic (console.anthropic.com) - server-only, never expose to the browser
ANTHROPIC_API_KEY=
